rules_version = '2';

// Caffiend Firestore security rules.
//
// Data model: one document per user (users/{userId}). All coffee entries
// are fields inside that document, so scoping rules to the document is
// enough: a signed-in user may only read and write their own document.
//
// The deny-all catch-all keeps anything not explicitly allowed closed
// (defense in depth). If a new collection is added later, it stays closed
// until someone writes an explicit match block for it.
//
// How to apply:
//   1. Firebase Console -> Firestore Database -> Rules -> paste this file.
//   2. Or, once you add firebase.json config to this repo:
//      npx firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    // Deny everything not explicitly allowed below.
    match /{documents=**} {
      allow read, write: if false;
    }

    // Users may only access their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
